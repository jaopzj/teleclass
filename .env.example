TG_API_ID=123456            # obtido em https://my.telegram.org
TG_API_HASH=abcdef...
TELEAULA_DATA_DIR=./data
# TELEAULA_STREAM_CACHE_MB=256   # memória para trechos de vídeo já baixados
# TELEAULA_DISK_CACHE_MB=4096    # disco (data/cache) para trechos já baixados; 0 desliga
# TELEAULA_PORT=8000             # porta no PC ao rodar com Docker (docker compose)

# Servidor na internet (docs/deploy-oracle.md)
# TELEAULA_DOMAIN=meuteleclass.duckdns.org   # domínio do HTTPS (Caddy)
# TELEAULA_INVITE_CODE=troque-isto           # se definido, criar conta exige este código
